# ── Default: normalize line endings to LF ───────────────────────
* text=auto eol=lf

# ── Source files (always LF) ────────────────────────────────────
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.py     text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf

# ── Git config files ────────────────────────────────────────────
.gitignore     text eol=lf
.gitattributes text eol=lf
LICENSE        text eol=lf

# ── Binary / Udon assets ────────────────────────────────────────
*.udonasm      binary
*.meta         binary
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.ico          binary
*.woff         binary
*.woff2        binary
*.ttf          binary
*.otf          binary

# ── GitHub Linguist: mark Udon assembly as non-primary language ─
*.udonasm linguist-language=Assembly linguist-detectable=false
